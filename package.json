{
  "name": "DetectX",
  "version": "1.1.1",
  "description": "DetectX - Advanced Hardware Detection & Game Compatibility Analyzer",
  "main": "main.js",
  "author": "Edwin Thomas",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:win": "electron-builder --win",
    "publish": "electron-builder --win --publish always",
    "pack": "electron-builder --dir"
},
  "build": {
    "appId": "com.edwinthomas.detectx",
    "productName": "DetectX",
    "copyright": "Copyright © 2026 Edwin Thomas. All Rights Reserved.",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "edwin6894",
        "repo": "DetectX---Hardware-Detection-and-Game-compatibility-"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "publisherName": "Edwin Thomas",
       "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DetectX",
      "license": "LICENSE"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "systeminformation": "^5.21.7"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
